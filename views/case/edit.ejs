<% layout('layouts/boilerplate')%>
<!-- Button trigger modal -->
<button
  type="button"
  class="btn btn-outline-warning bg-gradient px-2 py-1 me-2"
  data-bs-toggle="modal"
  data-bs-target="#ncaisse-<%= caisse.id %>"
>
  <i class="bi bi-pencil-fill"></i>
</button>

<!-- Modal -->
<div
  class="modal fade"
  id="ncaisse-<%= caisse.id %>"
  data-bs-backdrop="static"
  data-bs-keyboard="true"
  tabindex="-1"
  aria-labelledby="staticBackdropLabel"
  aria-hidden="true"
>
  <div
    class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"
  >
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="staticBackdropLabel">
          تعديل باقة المستثمر <%= caisse.user.fullname %>
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form
          class="row p-2 needs-validation"

          action="case/<%= caisse.id %>?_method=PUT"

          method="POST"
        >
          <div class="form-floating mb-2 col-sm-12 col-md-6 col-lg-4">
            <input
              class="form-control border border-success"
              type="text"
              id="reference"
              name="caisse[reference]"
              value="<%=caisse.reference%>"
              placeholder=""
              readonly
              required
            />
            <label for="reference" class="form-labelfs-6">رقم المرجع:</label>
            <div class="valid-feedback">صحيح</div>
          </div>

          <div class="form-floating mb-2 col-sm-12 col-md-6 col-lg-4">
            <input
              class="form-control border border-success"
              type="number"
              id="initAmount"
              name="caisse[initAmount]"
              value="<%=caisse.initAmount%>"
              required
            />
            <label for="initAmount" class="form-labelfs-6">المبلغ:</label>
            <div class="valid-feedback">صحيح</div>
          </div>

          <div class="form-floating mb-2 col-sm-12 col-md-6 col-lg-4">
            <input class="form-control border border-success" type="date"
            id="startDate" name="caisse[startDate]"
            value="<%=moment(caisse.startDate).format("YYYY-MM-DD")%>" required
            />
            <label for="startDate" class="form-labelfs-6">تاريخ البداية:</label>
            <div class="valid-feedback">صحيح</div>
          </div>

          <div class="form-floating col-sm-12 col-md-6 col-lg-6 mb-2">
            <select
              id="user"
              name="caisse[user]"
              class="form-select border border-success"
            >
              <option selected disabled value="">المستثمر</option>
              <% for (user of users){%> <% if(user.id == caisse.user.id) {%>
              <option class="option" value="<%= user.id%>" selected>
                <%= user.email%> <%= user.fullname%> <%= user.phone%>
              </option>
              <% }else{ %>
              <option class="option" value="<%= user.id%>">
                <%= user.email%> <%= user.fullname%> <%= user.phone%>
              </option>
              <%}}%>
            </select>
            <label for="user" class="form-label">المستثمر</label>
            <div class="valid-feedback">صحيح</div>
          </div>
          <div class="form-floating col-sm-12 col-md-12 col-lg-6 mb-2">
            <select
              id="pack"
              name="caisse[pack]"
              class="form-select border border-success"
            >
              <option selected disabled value="">الباقة</option>
              <% for (pack of packs){%>
              <% if (pack.id==caisse.pack.id){%>
              <option class="option" value="<%= pack.id%>" selected>
                <%= pack.title%> <%= pack.period%> <%= pack.unite%>
              </option>
              <% }else{ %>
                <option class="option" value="<%= pack.id%>">
                  <%= pack.title%> <%= pack.period%> <%= pack.unite%>
                </option>
              <%}}%>
            </select>
            <label for="pack" class="form-label">المستثمر</label>
            <div class="valid-feedback">صحيح</div>
          </div>

          <div class="mb-2">
            <textarea
              class="form-control border border-success"
              type="text"
              id="description"
              name="caisse[description]"
              placeholder="تفاصيل الباقة"
              rows="4"
              required
            ><%= caisse.description %></textarea>
            <div class="valid-feedback">صحيح</div>
          </div>
          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-outline-danger"
              data-bs-dismiss="modal"
            >
              إلغاء
            </button>
            <button class="btn btn-outline-warning">تعديل</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
